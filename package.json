{
  "name": "radiobot",
  "version": "2.0.0",
  "description": "Your hobbyist radio station solution.",
  "keywords": [
    "radio",
    "bot",
    "hls",
    "shoutcast",
    "autodj"
  ],
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "prebuildify --napi --strip",
    "install": "node-gyp-build",
    "prepare": "husky"
  },
  "author": "licson0729",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/licson0729/radiobot.git"
  },
  "bugs": {
    "url": "https://github.com/licson0729/radiobot/issues",
    "email": "admin@licson.net"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.19.0",
    "express": "^4.21.0",
    "fs-extra": "^11.3.0",
    "grammy": "^1.41.0",
    "node-addon-api": "^8.0.0",
    "node-cron": "^3.0.3",
    "node-gyp-build": "^4.8.0",
    "socket.io": "^4.8.0",
    "undici": "^6.21.0",
    "youtubei.js": "^13.3.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "husky": "^9.1.0",
    "prebuildify": "^6.0.0",
    "prettier": "^3.5.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
